body {
    font-family: Arial, sans-serif;
    line-height: 1.6;
    margin: 0;
    padding: 0;
    background-color: #e5adf4;
    color: #333;
}

header {
    background-color: #d581db;
    color: #fff;
    text-align: center;
    padding: 2rem 1rem;
}

header img {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #fff;
}

main {
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1rem;
}

section {
    background: #c868a8;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    border-radius: 8px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

h1, h2 {
    color: #2c3e50;
}

header h1 {
    color: #fff;
}

a {
    color: #d534db;
    text-decoration: none;
}

footer {
    text-align: center;
    padding: 1rem;
    background-color: #2c3e50;
    color: #fff;
}